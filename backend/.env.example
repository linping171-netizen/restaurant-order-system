PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
# Fill these from the Supabase project; never expose the service-role key to the frontend.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy key name also accepted if your project only shows service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Leave PGSSLMODE unset for Supabase TLS. Set to disable only for local PostgreSQL.
PGSSLMODE=

# Required before using administrator login or guest order history.
# Generate credentials interactively with: npm run setup:admin
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
